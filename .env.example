MJAI_ENV=development
MJAI_API_KEY=change-me
MJAI_BACKEND=memory
MJAI_DATA_DIR=./data
# 只有 Compose 读它：六份持久化数据在宿主机上的根目录，api / postgres / clickhouse /
# rustfs / redpanda / mihomo 各占一个子目录。和上面那个不是一回事——上面是 API 进程
# 自己看到的路径，在容器里固定是 /var/lib/mjai，而这里的子目录由 Docker 守护进程
# 创建、属于 root，所以两者不共用 ./data。默认值只够本地开发和 CI 用，部署要指向一个
# 自己管理的绝对路径，迁移就是搬这一个目录。
MJAI_STORAGE_ROOT=./storage
# 语料单独放在别的盘上。不设就是 MJAI_STORAGE_ROOT 下的 rustfs，也就是这个变量存在
# 之前的行为。
#
# 值得单独指的只有它：六份数据里只有它跟着语料长，而 ClickHouse 和 Postgres 要的是
# 随机 I/O、该留在 SSD 上。1.9 亿局按实测每条两万字节压后是 3.75 TB，不该由系统盘扛。
#
# 用变量而不是往 /etc/fstab 里加绑定挂载：后者要 root，写错一行影响开机，而且失败是
# 静默的 —— 挂载没生效 rustfs 就往下面那个空目录里写，语料一半在这块盘一半在那块，
# 不报任何错。改这个值不会搬走已有数据，先搬再改。
# MJAI_RUSTFS_ROOT=/storage/mjai-rustfs
MJAI_MAX_RECORD_BYTES=262144
MJAI_MAX_BATCH_BYTES=536870912
MJAI_MAX_BATCH_RECORDS=50000
MJAI_PACK_TARGET_BYTES=268435456
# Required: the API refuses to start without both, rather than serving an empty
# index. Inside Compose these are the service names, not localhost.
MJAI_POSTGRES_DSN=postgres://mjai:mjai@localhost:5432/mjai
MJAI_CLICKHOUSE_URL=http://localhost:8123
MJAI_CLICKHOUSE_USER=mjai
MJAI_CLICKHOUSE_PASSWORD=mjai
MJAI_DATABASE_WAIT_SECS=120
MJAI_MIHOMO_CONTROLLER_URL=http://localhost:9090
MJAI_MIHOMO_SECRET=change-mihomo-me
MJAI_MIHOMO_PROXY_URL=http://localhost:7890
# Development shortcut; production should use a mounted file secret.
MAJSOUL_ACCOUNTS=
# The re-fetch pool's accounts, one `username,password` per line. It opens one
# session per account, so this is also what caps its concurrency — and a second
# login on an account ends the first session, so none of these may be an account
# a collector uses. Sharing one secret between the two is fine: a collector takes
# the first line, the pool takes every line no collector holds. Reference it from
# the console's 牌谱补抓 page as `env:MAJSOUL_REFETCH_ACCOUNTS`, or point that
# field at a `file:` secret and leave this empty.
MAJSOUL_REFETCH_ACCOUNTS=
MJAI_PUBLIC_URL=http://localhost:3000
MJAI_ADMIN_EMAIL=admin@example.com
MJAI_ADMIN_PASSWORD=change-this-password
MJAI_EMAIL_API_URL=https://api.resend.com/emails
MJAI_EMAIL_API_TOKEN=
MJAI_EMAIL_FROM=noreply@example.com

# Packs are uploaded here at boot, read back from here when the local copy is
# gone, and swept for orphans on MJAI_GC_INTERVAL_SECS. The region is never
# validated by RustFS; it only has to match what the bucket was created with.
MJAI_S3_ENDPOINT_URL=http://localhost:9000
MJAI_S3_ACCESS_KEY=rustfsadmin
MJAI_S3_SECRET_KEY=rustfsadmin
MJAI_S3_BUCKET=mjai-raw
MJAI_S3_REGION=us-east-1

# An object younger than the grace period is never collected, however orphaned
# it looks: an upload whose index rows are still in flight looks the same as one
# whose writer died.
MJAI_GC_GRACE_SECS=86400
MJAI_GC_INTERVAL_SECS=3600

# Ingest produces the raw mjson here and answers 202 only once the broker has
# acknowledged it; the pack/index worker consumes from here, and its offsets
# live in PostgreSQL because rskafka has no consumer groups. Past
# MJAI_KAFKA_MAX_LAG unindexed records, ingest is refused so the topic cannot
# outgrow its retention; 0 refuses everything, which is the way to stop ingest
# without stopping the process. Retention itself is not settable from here: it
# is a Redpanda cluster property, sized for the historical import in
# deploy/redpanda/bootstrap.yml.
MJAI_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MJAI_KAFKA_TOPIC=mjai.records.raw
# 一个分区一条打包线程，而打包线程是整条管道最窄的地方：每条记录都要解一次
# gzip、解析两遍 mjai、跑一遍牌局算选手统计、算 sha256、压两个 zstd 帧，实测
# 3.4 毫秒，而且封 256MB 的包时它根本不消费。之前这里是 1，结果是 290 条/秒、
# 56 个核闲着、topic 顶在 MJAI_KAFKA_MAX_LAG 上、400 个已登录账号在里面睡觉——
# 加账号完全没用，因为账号从来就不是瓶颈。
#
# 已经有 topic 的部署改这个要两步（rskafka 只会建 topic，加不了分区）：先在
# broker 上 `rpk topic add-partitions <topic> --num <再加几个>`，再重启。分区
# 只能加不能减，启动时会按 topic 现有的分区数来，两边对不上会打日志说清楚。
#
# 这个数还决定 retention：Redpanda 的 retention_bytes 是**每个分区**的，
# docker-compose.yml 里的保留量沿用总量 40GiB，按这个数除下去分摊。所以在
# broker 上加了分区却不改这里，等于每个分区都拿满额——八个分区就是 320GiB。
MJAI_KAFKA_PARTITIONS=8
# 这个数是**每个分区**的，跟 retention_bytes 一样，而且是同一个道理：打包线程封
# 包时才提交位点，所以每个分区常态就落后一个封包周期，八个分区在全都追平的情况下
# 也会落后八倍。当成整个 topic 的总量读，就变成对健康管道的限流——实测常态积压
# 26,000 顶着 25,000 的门槛，十分钟里补抓让位十一次，而每次那条打包线程都是追平
# 状态。0 还是「拒绝一切」，乘几都是 0。
MJAI_KAFKA_MAX_LAG=50000
# 只有 Compose 读它们：broker 占几个核、吃多少内存。Redpanda 把一个分区交给一个
# 核，而 Seastar 的 --memory 是启动时就占住的，所以这两个数是一起改的（官方给的
# 比例是一个核两 G）。默认 4 核 8G 是给上面那 8 个分区留的余量——实测 290 条/秒
# 时 broker 只用了一个核的 2.5%，它不是瓶颈，只是不重启就加不了。CI 和 make
# test-infra 会自己压到 1 核 1G，见 Makefile。
# MJAI_REDPANDA_CORES=4
# MJAI_REDPANDA_MEMORY=8G

# A pack is sealed, uploaded and indexed when it reaches MJAI_PACK_TARGET_BYTES
# or when its oldest record has waited this long. Size alone would leave a quiet
# period's records invisible to every query until 256MB had accumulated, which
# at the live collection rate is weeks.
MJAI_PACK_MAX_AGE_SECS=300
# The age at which a pack seals once the worker has caught up with the topic.
# Between two games arriving there is nothing left to fill the open pack, so
# waiting out the full limit above only delays those records becoming readable
# and leaves the broker's single volume holding the only copy of bytes the API
# has already accepted. Lower it to shrink that window; the objects it adds are
# proportional to how little traffic there was, and under load the worker is
# never caught up so the size target still decides。
#
# 「压满的时候 worker 追不上」这句在分区提到 8 个之后就不成立了：每条打包线程只
# 看八分之一的流量，随时都能追平自己那个分区，于是几乎每个包都是这条规则封的。
# 实测 670 条/秒时五分钟封了 56 个包、每个才 48MB（目标是 256MB）——一天一万六
# 千个对象，而按大小封只会有三千个。两分钟仍然是个有界的可读延迟，这个速率下能
# 让一个包长到 135MB 左右。
MJAI_PACK_IDLE_SECS=120
