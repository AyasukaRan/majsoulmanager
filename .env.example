MJAI_ENV=development
MJAI_API_KEY=change-me
MJAI_BACKEND=memory
MJAI_DATA_DIR=./data
MJAI_MAX_RECORD_BYTES=262144
MJAI_MAX_BATCH_BYTES=536870912
MJAI_MAX_BATCH_RECORDS=50000
MJAI_PACK_TARGET_BYTES=268435456
# Required: the API refuses to start without both, rather than serving an empty
# index. Inside Compose these are the service names, not localhost.
MJAI_POSTGRES_DSN=postgres://mjai:mjai@localhost:5432/mjai
MJAI_CLICKHOUSE_URL=http://localhost:8123
MJAI_CLICKHOUSE_USER=mjai
MJAI_CLICKHOUSE_PASSWORD=mjai
MJAI_DATABASE_WAIT_SECS=120
MJAI_MIHOMO_CONTROLLER_URL=http://localhost:9090
MJAI_MIHOMO_SECRET=change-mihomo-me
MJAI_MIHOMO_PROXY_URL=http://localhost:7890
# Development shortcut; production should use a mounted file secret.
MAJSOUL_ACCOUNTS=
MJAI_PUBLIC_URL=http://localhost:3000
MJAI_ADMIN_EMAIL=admin@example.com
MJAI_ADMIN_PASSWORD=change-this-password
MJAI_EMAIL_API_URL=https://api.resend.com/emails
MJAI_EMAIL_API_TOKEN=
MJAI_EMAIL_FROM=noreply@example.com

# Packs are uploaded here at boot, read back from here when the local copy is
# gone, and swept for orphans on MJAI_GC_INTERVAL_SECS. The region is never
# validated by RustFS; it only has to match what the bucket was created with.
MJAI_S3_ENDPOINT_URL=http://localhost:9000
MJAI_S3_ACCESS_KEY=rustfsadmin
MJAI_S3_SECRET_KEY=rustfsadmin
MJAI_S3_BUCKET=mjai-raw
MJAI_S3_REGION=us-east-1

# An object younger than the grace period is never collected, however orphaned
# it looks: an upload whose index rows are still in flight looks the same as one
# whose writer died.
MJAI_GC_GRACE_SECS=86400
MJAI_GC_INTERVAL_SECS=3600

# Not wired up yet: ingest still packs and indexes inline.
MJAI_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
